# ─── Supabase ────────────────────────────────────────────────────────
# From the Media House project: Settings -> API.
# Run supabase/schema.sql in the SQL editor first.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Where magic-link / confirmation emails should send people back to.
NEXT_PUBLIC_SITE_URL=http://localhost:3005

# ─── Admin access ─────────────────────────────────────────────────────
# Comma-separated list of the ONLY email addresses allowed into /admin.
#
# This is the master switch. Even if a profile row has is_admin = true, a
# login whose email is not in this list is refused. Anyone not listed here
# is treated as an ordinary client.
#
# Add more addresses only by editing this file, then restarting the server.
ADMIN_EMAILS=jtsaofficial@gmail.com

# --- Transactional email (Brevo) ---------------------------------
# Needed for notifications: new enquiry, milestone approved.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=JTSA Media House

# Where admin alerts are delivered. Defaults to BREVO_SENDER_EMAIL.
ADMIN_NOTIFY_EMAIL=
